# Python caches and virtual environments
__pycache__/
*.py[cod]
.venv/
venv/

# Notebook and editor artifacts
.ipynb_checkpoints/
.vscode/
.idea/

# Local environment and OS files
.env
.env.*
!.env.example
.DS_Store
Thumbs.db

# Local databases and generated runtime files
*.duckdb
*.duckdb.wal
*.db
*.log

# dbt build output and package cache
dbt_project/target/
dbt_project/logs/
dbt_project/dbt_packages/
dbt_project/.user.yml

# Generated/intermediate data (raw Olist CSV files are intentionally tracked)
data/exports/*
!data/exports/.gitkeep
data/reference/*.tmp
data/profiling/*.tmp

# Build and test caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.egg-info/
