# Python caches and virtual environments
__pycache__/
*.py[cod]
.venv/
venv/

# Notebook and editor artifacts
.ipynb_checkpoints/
.vscode/
.idea/

# Local environment and OS files
.env
.env.*
!.env.example
.DS_Store
Thumbs.db

# Local databases and generated runtime files
*.duckdb
*.duckdb.wal
*.db
*.log

# dbt build output and package cache
dbt_project/target/
dbt_project/logs/
dbt_project/dbt_packages/
dbt_project/.user.yml

# Generated/intermediate data (raw Olist CSV files are intentionally tracked)
data/exports/*
!data/exports/.gitkeep
# [Sửa] 3 mart + kết quả kiểm thử là đầu vào bắt buộc của dashboard (Task E05 -> F01), cần có trên repo
!data/exports/mart_sales.parquet
!data/exports/mart_delivery.parquet
!data/exports/mart_customer.parquet
!data/exports/quality_results.parquet
data/reference/*.tmp
data/profiling/*.tmp

# Build and test caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.egg-info/
